{
  "schemaVersion": 1,
  "id": "androidmic.quickshell",
  "name": "AndroidMic",
  "version": "1.0.0",
  "author": "AndroidMic contributors",
  "description": "Use your Android phone as a mic for your PC. Stream status, connect/disconnect and audio settings from the bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "AndroidMic",
    "description": "AndroidMic stream controller and settings.",
    "category": "Media",
    "allowMultiple": false,
    "defaults": {
      "autoOpen": false
    },
    "schema": [
      {
        "key": "autoOpen",
        "type": "boolean",
        "label": "Open panel when stream connects",
        "defaultValue": false
      }
    ]
  },
  "omarchy": {
    "clonePaths": [
      { "source": "Options.js", "target": "Options.js" },
      { "source": "Mock.js", "target": "Mock.js" }
    ]
  }
}