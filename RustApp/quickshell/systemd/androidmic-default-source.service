[Unit]
Description=Set phone virtual mic as default PulseAudio source
# PipeWire publishes a Pulse socket; start after it is available, and after
# the virtual-mic unit has created the virtual_mic sink (pactl needs the
# source to already exist, otherwise set-default-source fails with
# "No such entity" — both units are WantedBy=default.target, so without
# this ordering they race at every login).
After=pipewire.service pipewire.socket wireplumber.service androidmic-virtual-mic.service
Wants=pipewire.socket wireplumber.service androidmic-virtual-mic.service
PartOf=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Installed to the user config by install.sh.
ExecStart=/usr/bin/sh -c 'for i in $(seq 1 30); do pactl info >/dev/null 2>&1 && break; sleep 1; done; for i in $(seq 1 10); do pactl set-default-source virtual_mic.monitor && exit 0; sleep 1; done; exit 1'

[Install]
WantedBy=default.target
